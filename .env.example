# TinaCMS — Tina Cloud (editing session)
NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=
NEXT_PUBLIC_TINA_BRANCH=main

# Enquiry form — public access key from https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_KEY=

# Canonical site URL (no trailing slash) — used for metadata, sitemap, JSON-LD
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Google Search Console — HTML tag verification. Search Console shows this as
# <meta name="google-site-verification" content="..." />; paste just the
# content value here. Leave blank to verify by DNS TXT record instead (no
# code change needed for that method).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
